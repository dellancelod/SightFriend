@model User
@{
    string strTitle = "Редагувати користувача";
    ViewBag.Title = strTitle;
}
<div>
    <h2>@strTitle</h2>
    <div>
        <form asp-area="Admin" asp-controller="Users" asp-action="Edit" method="post" enctype="multipart/form-data">


            <div asp-validation-summary="All"></div>
            <div class="form-group">
                <label asp-for="UserName"></label>
                <input asp-for="UserName" class="form-control" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber"></label>
                <input asp-for="PhoneNumber" class="form-control" id="phone-num-field" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>


            <button type="submit" class="btn btn-primary">Створити</button>
        </form>
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" asp-route-id="">
            Відмінити редагування
        </a>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}